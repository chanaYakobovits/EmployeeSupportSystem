{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Issuer": "EmployeeSupportSystem",
    "Audience": "EmployeeSupportSystem.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Ai": {
    "Enabled": true,
    "Model": "gpt-4o-mini",
    "TimeoutSeconds": 30,
    "Temperature": 0.2,
    "MaxAttempts": 3,
    "MinConfidence": 0.6,
    "WorkerIntervalSeconds": 5,
    "BatchSize": 10,
    "FallbackAfterMinutes": 15
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "no-reply@ovdenet.example.com",
    "FromName": "עובדנט",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "UserName": "",
      "TimeoutSeconds": 30
    },
    "File": {
      "Directory": "App_Data/emails"
    }
  },
  "Invitations": {
    "FrontendBaseUrl": "",
    "ExpiryHours": 72,
    "WorkerIntervalSeconds": 10,
    "BatchSize": 10,
    "MaxAttempts": 4,
    "RetryDelaysMinutes": [ 1, 5, 30 ],
    "LockMinutes": 5
  },
  "AllowedHosts": "*"
}
